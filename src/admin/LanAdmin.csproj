<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>LanAdmin</AssemblyName>
    <RootNamespace>LanSuite.Admin</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\shared\LanSuite.Shared.csproj" />
    <ProjectReference Include="..\client\LanClient.csproj" />
    <ProjectReference Include="..\server\LanServer.csproj" />
  </ItemGroup>
</Project>
